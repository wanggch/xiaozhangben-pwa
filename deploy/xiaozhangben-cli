#!/usr/bin/env bash
# 小账本管理命令包装：以服务用户身份、使用 /etc/xiaozhangben/env 的配置运行 server/dist/cli.js
# 用法：sudo xiaozhangben-cli <命令> [参数]，例如 sudo xiaozhangben-cli create-user me@example.com --admin
set -euo pipefail
if [[ $EUID -ne 0 ]]; then exec sudo "$0" "$@"; fi
umask 0027
set -a; . /etc/xiaozhangben/env; set +a
# @NODE_BIN@ 由 install.sh 替换；若 env 里有 NODE_BIN 则优先用 env
NODE="${NODE_BIN:-@NODE_BIN@}"
cd /opt/xiaozhangben/current/server
exec runuser -u xiaozhangben -- "$NODE" dist/cli.js "$@"
