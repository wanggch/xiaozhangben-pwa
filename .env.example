# 小账本服务端配置示例。复制为 .env（本地）或 /etc/xiaozhangben/env（服务器），不要提交真实配置。
# 本服务不需要任何密钥：会话令牌随机生成且只在数据库中保存哈希。

# 监听地址：生产环境只监听本机，由 Caddy 反向代理并提供 HTTPS
HOST=127.0.0.1
PORT=8787

# 对外访问地址（用于 Origin 校验与 Secure Cookie 判断），必须与浏览器地址栏一致
PUBLIC_ORIGIN=https://ledger.example.com

# 数据库与前端文件
DB_PATH=/var/lib/xiaozhangben/xiaozhangben.db
WEB_ROOT=/opt/xiaozhangben/current/web

# 是否开放注册（默认关闭；第一个账号用 CLI 创建：xiaozhangben-cli create-user you@example.com）
ALLOW_SIGNUP=false

# Cookie 是否带 Secure（默认：PUBLIC_ORIGIN 为 https 时开启）
# COOKIE_SECURE=true

# 信任的反向代理（用于获取真实客户端 IP 做限流），默认 loopback（Caddy 在本机）
TRUST_PROXY=loopback

# 会话有效期：滑动 30 天，最长 180 天
SESSION_DAYS=30
SESSION_MAX_DAYS=180

LOG_LEVEL=info

# 每个 IP 每 10 分钟允许的登录/注册请求数
# AUTH_RATE_LIMIT=20
